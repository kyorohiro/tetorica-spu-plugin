  "scope": "AU preset-name consistency across factory/PresentPreset/CurrentPreset/ClassInfo; split VH/VB file worker and editor flow; local guarded AU deployment and old GarageBand VAB save/reopen. No parameter/state-schema/SDK/Web/Tauri/npm/version/tag/release changes.",
  "specification": {
    "preset_names": "One initialized TetoricaSPU factory preset. Public Present/Current user names and numbers are copied and retained; ClassInfo restore commits a descriptive user name with number -1 only after complete sound validation. Names never trigger source recall. Factory number 0 recalls the immutable default sound and name.",
    "name_limit_utf16_units": 1024,
    "name_inputs": "Unicode, empty, mutable and bounded names accepted; invalid CF types/identity/body/names/property sizes/scope/element/factory number rejected without changing saved or active sound.",
    "au_dispatch": "Plugin-only modern 64-bit AudioComponent Lookup specialization intercepts Present/Current property Get/Set; all other selectors including MIDI forward to the pinned official factory. ABI signatures statically match Apple AudioUnitGetPropertyProc and AudioUnitSetPropertyProc. Legacy ComponentManager path not expanded.",
    "threading": "Existing serialized host ingress and quiescent state-restore contract. Preset metadata and preparation are non-RT; notifications occur outside state locks.",
    "split_api": "VabLoader::requestSplitFiles(vhPath,vbPath[,flatTone]); missing index selects first playable Tone, explicit index is exact.",
    "split_limits": {
      "versions": [
        6,
        7
      ],
      "header_bytes": 68128,
      "body_bytes": 524288,
      "combined_bytes": 1048576
    },
    "split_storage": "Exact original VH bytes followed by original VB bytes after split parser validation; no ADPCM re-encoding or metadata reconstruction. Standard embedded VAB/state9/selected-Tone Web export, original padding and Morph A/B retained.",
    "pair_identity_limit": "No pair checksum exists; a structurally valid unrelated body of the same layout cannot be distinguished.",
    "editor": "Load sound accepts either VH or VB first; matching partner dialog is deferred to OnIdle without state/lifetime locks, starts in same directory and filters opposite extension. No request/cancellation of prior pending work until both selections complete. Cancel, stale revision/generation/serial or closed lifetime cannot submit a load.",
    "failure_semantics": "Cancelled selection preserves pending work. A submitted failed worker request retains active audio but supersedes older pending generations, as for complete VAB input. Already accepted worker work follows the normal exchange even if the editor closes.",
