{
  "version": 6,
  "configurePresets": [
    {
      "name": "offline",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/offline",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TETORICA_BUILD_PLUGIN": "OFF"
      }
    },
    {
      "name": "macos",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "TETORICA_BUILD_PLUGIN": "ON",
        "IPLUG_DEPLOY_PLUGINS": "OFF"
      }
    },
    {
      "name": "macos-release",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "IPLUG2_UNIVERSAL": "ON"
      }
    },
    {
      "name": "windows",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "TETORICA_BUILD_PLUGIN": "ON",
        "IPLUG_DEPLOY_PLUGINS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    }
  ],
