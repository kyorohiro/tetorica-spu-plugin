{
  "version": 6,
  "configurePresets": [
    {
      "name": "offline",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/offline",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TETORICA_BUILD_PLUGIN": "OFF"
      }
    },
    {
      "name": "macos",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "TETORICA_BUILD_PLUGIN": "ON",
        "IPLUG_DEPLOY_PLUGINS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "offline", "configurePreset": "offline", "targets": ["gain_smoother_test", "spu_all_sound_off_test", "ui_midi_queue_test", "software_pcm_state_test", "software_pcm_instrument_test", "software_audio_loader_test", "software_pcm_web_test", "wav_import_test", "adpcm_playback_test", "audio_file_loader_test", "spu_export_source_test", "web_instrument_export_test", "web_instrument_exporter_test", "spu_adpcm_test", "web_instrument_test", "web_instrument_loader_test", "spu_morph_test", "morph_draft_test", "spu_pmon_test", "spu_noise_test", "pcm_draft_test", "spu_waveform_test", "spu_instrument_test", "vab_bank_test", "spu_vab_instrument_test", "spu_engine_exchange_test", "vab_loader_test", "instrument_state_test", "spu_vab_render"] },
    { "name": "macos", "configurePreset": "macos", "targets": ["gain_smoother_test", "spu_all_sound_off_test", "ui_midi_queue_test", "software_pcm_state_test", "software_pcm_instrument_test", "software_audio_loader_test", "software_pcm_web_test", "TetoricaSPU-app", "TetoricaSPU-au", "TetoricaSPU-vst3", "wav_import_test", "adpcm_playback_test", "audio_file_loader_test", "spu_export_source_test", "web_instrument_export_test", "web_instrument_exporter_test", "spu_adpcm_test", "web_instrument_test", "web_instrument_loader_test", "spu_morph_test", "morph_draft_test", "spu_pmon_test", "spu_noise_test", "pcm_draft_test", "spu_waveform_test", "spu_instrument_test", "vab_bank_test", "spu_vab_instrument_test", "spu_engine_exchange_test", "vab_loader_test", "instrument_state_test", "spu_vab_render", "tetorica_au_state_check"] }
  ],
  "testPresets": [
